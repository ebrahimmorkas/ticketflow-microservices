{
  "RateLimiting": {
    "PermitsPerMinute": 120,
    "BookingPermitsPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "availability": {
        "ClusterId": "booking",
        "Order": -1,
        "Match": { "Path": "/api/events/{eventId}/availability" }
      },
      "events": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events/{**catch-all}" }
      },
      "bookings-create": {
        "ClusterId": "booking",
        "Order": -1,
        "RateLimiterPolicy": "bookings",
        "Match": { "Path": "/api/bookings", "Methods": [ "POST" ] }
      },
      "bookings": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/bookings/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "events": {
        "Destinations": { "d1": { "Address": "https+http://events-api" } }
      },
      "booking": {
        "Destinations": { "d1": { "Address": "https+http://booking-api" } }
      },
      "payments": {
        "Destinations": { "d1": { "Address": "https+http://payments-api" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
